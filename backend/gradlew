APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (both for OS X, Registry etc.)
darwin=false
case "`uname`" in
  Darwin* )
    darwin=true
    ;;
esac

CLASSPATH=""
which gradle >/dev/null 2>&1
if [ $? -eq 0 ]; then
    exec gradle "$@"
else
    # If gradle is not installed, run dockerized gradle or inform user
    if which docker >/dev/null 2>&1; then
        exec docker run --rm -v "$PWD":/app -w /app gradle:8.7-jdk17 gradle "$@"
    else
        die "ERROR: Neither Gradle nor Docker was found. Please install Gradle 8.x or Docker."
    fi
fi
